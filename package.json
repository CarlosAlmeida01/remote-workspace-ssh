{
  "name": "remote-workspace-ssh",
  "displayName": "Remote Workspace SSH",
  "description": "SSH workspace access with Windows proxy path fixes, Linux setup script normalization, and connection links.",
  "version": "0.1.2",
  "publisher": "workspace-ssh-tools",
  "engines": {
    "vscode": "^1.70.2"
  },
  "main": "./lib/extension.js",
  "browser": "./lib/extension.js",
  "scripts": {
    "build": "npm run clean && npm run compile:src && npm run bundle",
    "bundle": "webpack --mode production",
    "bundle:dev": "webpack --mode development",
    "clean": "rimraf --glob lib out *.vsix .test",
    "compile:src": "tsc -b",
    "compile:test": "tsc -p test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run --reporter tree",
    "test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
    "test:images": "./dockerfiles/build.sh",
    "test:ui": "vitest --ui --coverage",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build",
    "watch:src": "tsc-watch -p . --onSuccess 'npm run bundle:dev'",
    "watch:test": "tsc-watch -p test",
    "test:local": "vitest run test/proxy-command.test.ts test/script-template.test.ts test/connect-uri.test.ts",
    "update:dts": "npx --yes @vscode/dts@0.4.1 dev && npx --yes @vscode/dts@0.4.1 main",
    "package": "vsce package --no-dependencies",
    "lint:release": "eslint --no-config-lookup --config eslint.release.config.mjs scripts/release.cjs test/release.test.cjs",
    "test:release": "node --test test/release.test.cjs"
  },
  "dependencies": {
    "@zokugun/is-it-type": "0.8.1",
    "glob": "13.0.6",
    "semver": "7.8.5",
    "simple-socks": "3.6.0",
    "socks": "2.8.9",
    "ssh-config": "5.2.0",
    "ssh2": "git+https://github.com/jeanp413/ssh2#a169f627213aa663e0aa2fd2f0ef5c8931890c26"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "20.19.43",
    "@types/semver": "7.7.1",
    "@types/ssh2": "0.5.52",
    "@types/ssh2-streams": "0.1.13",
    "@types/webpack": "5.28.5",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vscode/vsce": "3.9.2",
    "@zokugun/fs-extra-plus": "0.5.0",
    "@zokugun/xtry": "0.11.6",
    "eslint": "10.8.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "fixpack": "4.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "memfs": "4.64.0",
    "release-it": "20.2.1",
    "rimraf": "6.1.3",
    "taze": "19.16.0",
    "ts-loader": "9.6.2",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "universalify": "2.0.1",
    "vitest": "4.1.10",
    "webpack": "5.109.0",
    "webpack-cli": "7.2.1",
    "yaml": "2.9.0"
  },
  "activationEvents": [
    "onCommand:workspaceRemoteSSH.openEmptyWindow",
    "onCommand:workspaceRemoteSSH.openEmptyWindowInCurrentWindow",
    "onCommand:workspaceRemoteSSH.openConfigFile",
    "onCommand:workspaceRemoteSSH.showLog",
    "onResolveRemoteAuthority:ssh-remote",
    "onView:workspaceSSHHosts",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "Remote - SSH",
      "properties": {
        "remote.SSH.configFile": {
          "type": "string",
          "description": "The absolute file path to a custom SSH config file.",
          "default": "",
          "scope": "application"
        },
        "remote.SSH.connectTimeout": {
          "type": "number",
          "description": "Specifies the timeout in seconds used for the SSH command that connects to the remote.",
          "default": 60,
          "scope": "application",
          "minimum": 1
        },
        "remote.SSH.defaultExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of extensions that should be installed automatically on all SSH hosts.",
          "scope": "application"
        },
        "remote.SSH.enableDynamicForwarding": {
          "type": "boolean",
          "description": "Whether to use SSH dynamic forwarding to allow setting up new port tunnels over an existing SSH connection.",
          "scope": "application",
          "default": true
        },
        "remote.SSH.enableAgentForwarding": {
          "type": "boolean",
          "markdownDescription": "Enable fixing the remote environment so that the SSH config option `ForwardAgent` will take effect as expected from VS Code's remote extension host.",
          "scope": "application",
          "default": true
        },
        "remote.SSH.serverDownloadUrlTemplate": {
          "type": "string",
          "description": "The URL from where the vscode server will be downloaded. You can use the following variables and they will be replaced dynamically:\n- ${quality}: vscode server quality, e.g. stable or insiders\n- ${version}: vscode server version, e.g. 1.69.0\n- ${commit}: vscode server release commit\n- ${arch}: vscode server arch, e.g. x64, armhf, arm64\n- ${release}: release number, vscodium only https://github.com/VSCodium/vscodium/pull/1192",
          "scope": "application"
        },
        "remote.SSH.remotePlatform": {
          "type": "object",
          "description": "A map of the remote hostname to the platform for that remote. Valid values: linux, macos, windows.",
          "scope": "application",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          }
        },
        "remote.SSH.remoteServerListenOnSocket": {
          "type": "boolean",
          "description": "When true, the remote vscode server will listen on a socket path instead of opening a port. Only valid for Linux and macOS remotes. Requires `AllowStreamLocalForwarding` to be enabled for the SSH server.",
          "default": false
        },
        "remote.SSH.serverInstallPath": {
          "type": "object",
          "description": "Specifies custom installation directories for the VS Code server on remote hosts. Maps each remote hostname (or pattern) to an absolute path where the server should be installed. Supports wildcards: use `*` for catch-all, or `*.domain.com` for domain-specific paths. More specific patterns take precedence over general ones. When not specified, the server installs in the default home directory. **Note**: Changing this setting may require manual cleanup of existing server installations in previous locations.",
          "scope": "application",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "remote.SSH.serverBinaryName": {
          "type": "string",
          "description": "The name of the server binary, use this **only if** you are using a client without a corresponding server release",
          "scope": "application",
          "default": ""
        },
        "remote.SSH.serverVersion": {
          "type": "string",
          "description": "The version number of the remote VSCodium server. Can take the values: 'match' (default), 'latest', 'closest' or a specific version (e.g. '1.117.0').",
          "scope": "application",
          "default": "match"
        },
        "remote.SSH.serverValidation": {
          "type": "string",
          "description": "Type of server validation: 'strict' (default) enforces that the remote and local server are the same version by matching the commit, 'force' modifies the remote commit to match the local server, 'skip' skips validation all together.",
          "scope": "application",
          "default": "strict",
          "enum": [
            "force",
            "skip",
            "strict"
          ],
          "enumDescriptions": [
            "Modify the commit of the remote server.",
            "The remote server won't validate the client.",
            "The remote server and client's commits must match. (default)"
          ]
        }
      }
    },
    "views": {
      "remote": [
        {
          "id": "workspaceSSHHosts",
          "name": "SSH Targets",
          "group": "targets@1",
          "remoteName": "ssh-remote"
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceRemoteSSH.openEmptyWindow",
        "title": "Connect to Host...",
        "category": "Remote-SSH"
      },
      {
        "command": "workspaceRemoteSSH.openEmptyWindowInCurrentWindow",
        "title": "Connect Current Window to Host...",
        "category": "Remote-SSH"
      },
      {
        "command": "workspaceRemoteSSH.openConfigFile",
        "title": "Open SSH Configuration File...",
        "category": "Remote-SSH"
      },
      {
        "command": "workspaceRemoteSSH.showLog",
        "title": "Show Log",
        "category": "Remote-SSH"
      },
      {
        "command": "workspaceRemoteSSH.explorer.emptyWindowInNewWindow",
        "title": "Connect to Host in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "workspaceRemoteSSH.explorer.emptyWindowInCurrentWindow",
        "title": "Connect to Host in Current Window"
      },
      {
        "command": "workspaceRemoteSSH.explorer.reopenFolderInCurrentWindow",
        "title": "Open on SSH Host in Current Window"
      },
      {
        "command": "workspaceRemoteSSH.explorer.reopenFolderInNewWindow",
        "title": "Open on SSH Host in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "workspaceRemoteSSH.explorer.deleteFolderHistoryItem",
        "title": "Remove From Recent List",
        "icon": "$(x)"
      },
      {
        "command": "workspaceRemoteSSH.explorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceRemoteSSH.explorer.configure",
        "title": "Configure",
        "icon": "$(gear)"
      },
      {
        "command": "workspaceRemoteSSH.explorer.add",
        "title": "Add New",
        "icon": "$(plus)"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-remote",
        "authority": "ssh-remote+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "SSH"
        }
      }
    ],
    "menus": {
      "statusBar/remoteIndicator": [
        {
          "command": "workspaceRemoteSSH.openEmptyWindow",
          "when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
          "group": "remote_20_ssh_1general@1"
        },
        {
          "command": "workspaceRemoteSSH.openEmptyWindowInCurrentWindow",
          "when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
          "group": "remote_20_ssh_1general@2"
        },
        {
          "command": "workspaceRemoteSSH.openConfigFile",
          "when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
          "group": "remote_20_ssh_1general@3"
        },
        {
          "command": "workspaceRemoteSSH.showLog",
          "when": "remoteName =~ /^ssh-remote$/ && remoteConnectionState == connected",
          "group": "remote_20_ssh_1general@4"
        },
        {
          "command": "workspaceRemoteSSH.openEmptyWindow",
          "when": "remoteConnectionState == disconnected",
          "group": "remote_20_ssh_3local@1"
        },
        {
          "command": "workspaceRemoteSSH.openEmptyWindowInCurrentWindow",
          "when": "remoteConnectionState == disconnected",
          "group": "remote_20_ssh_3local@2"
        },
        {
          "command": "workspaceRemoteSSH.openConfigFile",
          "when": "remoteConnectionState == disconnected",
          "group": "remote_20_ssh_3local@3"
        },
        {
          "command": "workspaceRemoteSSH.openEmptyWindow",
          "when": "!remoteName && !virtualWorkspace",
          "group": "remote_20_ssh_3local@5"
        },
        {
          "command": "workspaceRemoteSSH.openEmptyWindowInCurrentWindow",
          "when": "!remoteName && !virtualWorkspace",
          "group": "remote_20_ssh_3local@6"
        },
        {
          "command": "workspaceRemoteSSH.openConfigFile",
          "when": "!remoteName && !virtualWorkspace",
          "group": "remote_20_ssh_3local@7"
        }
      ],
      "commandPalette": [
        {
          "command": "workspaceRemoteSSH.explorer.refresh",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.configure",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.add",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.emptyWindowInNewWindow",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.emptyWindowInCurrentWindow",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.reopenFolderInCurrentWindow",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.reopenFolderInNewWindow",
          "when": "false"
        },
        {
          "command": "workspaceRemoteSSH.explorer.deleteFolderHistoryItem",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "workspaceRemoteSSH.explorer.add",
          "when": "view == workspaceSSHHosts",
          "group": "navigation"
        },
        {
          "command": "workspaceRemoteSSH.explorer.configure",
          "when": "view == workspaceSSHHosts",
          "group": "navigation"
        },
        {
          "command": "workspaceRemoteSSH.explorer.refresh",
          "when": "view == workspaceSSHHosts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceRemoteSSH.explorer.emptyWindowInNewWindow",
          "when": "viewItem =~ /^workspaceRemoteSSH.explorer.host$/",
          "group": "inline@1"
        },
        {
          "command": "workspaceRemoteSSH.explorer.emptyWindowInNewWindow",
          "when": "viewItem =~ /^workspaceRemoteSSH.explorer.host$/",
          "group": "navigation@2"
        },
        {
          "command": "workspaceRemoteSSH.explorer.emptyWindowInCurrentWindow",
          "when": "viewItem =~ /^workspaceRemoteSSH.explorer.host$/",
          "group": "navigation@1"
        },
        {
          "command": "workspaceRemoteSSH.explorer.reopenFolderInNewWindow",
          "when": "viewItem == workspaceRemoteSSH.explorer.folder",
          "group": "inline@1"
        },
        {
          "command": "workspaceRemoteSSH.explorer.reopenFolderInNewWindow",
          "when": "viewItem == workspaceRemoteSSH.explorer.folder",
          "group": "navigation@2"
        },
        {
          "command": "workspaceRemoteSSH.explorer.reopenFolderInCurrentWindow",
          "when": "viewItem == workspaceRemoteSSH.explorer.folder",
          "group": "navigation@1"
        },
        {
          "command": "workspaceRemoteSSH.explorer.deleteFolderHistoryItem",
          "when": "viewItem =~ /^workspaceRemoteSSH.explorer.folder/",
          "group": "navigation@3"
        },
        {
          "command": "workspaceRemoteSSH.explorer.deleteFolderHistoryItem",
          "when": "viewItem =~ /^workspaceRemoteSSH.explorer.folder/",
          "group": "inline@2"
        }
      ]
    }
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "categories": [
    "Other"
  ],
  "overrides": {
    "release-it": {
      "undici": "7.29.0"
    }
  },
  "allowScripts": {
    "fsevents": true
  },
  "keywords": [
    "remote",
    "remote development",
    "ssh",
    "coder",
    "kiro",
    "windows",
    "linux",
    "workspace"
  ],
  "api": "none",
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote"
  ],
  "extensionKind": [
    "ui"
  ],
  "license": "MIT",
  "author": "Carlos Almeida",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlosAlmeida01/remote-workspace-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/CarlosAlmeida01/remote-workspace-ssh/issues"
  },
  "homepage": "https://github.com/CarlosAlmeida01/remote-workspace-ssh#readme"
}
